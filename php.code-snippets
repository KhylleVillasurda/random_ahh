  "Clinic table rows": {
    "prefix": "clinrows",
    "description": "tbody loop with mirrored ID and edit/delete links",
    "body": [
      "<tbody>",
      "<?php while (\\$row = mysqli_fetch_assoc(\\$result)) { ?>",
      "    <tr>",
      "        <td><?= \\$row[\"${1:idCol}\"] ?></td>",
      "        <td><?= \\$row[\"${2:colA}\"] ?></td>",
      "        <td><?= \\$row[\"${3:colB}\"] ?></td>",
      "        <td>",
      "            <a href=\"${4:item_edit.php}?updateid=<?= \\$row[\"${1:idCol}\"] ?>\" class=\"btn btn-primary btn-sm\">UPDATE</a>",
      "            <a href=\"${5:item_delete.php}?deleteid=<?= \\$row[\"${1:idCol}\"] ?>\" class=\"btn btn-danger btn-sm\">DELETE</a>",
      "        </td>",
      "    </tr>",
      "<?php } ?>",
      "</tbody>"
    ]
  },
  "Clinic create form": {
    "prefix": "clincreate",
    "description": "full add page: FK dropdown query + insert + form",
    "body": [
      "<?php",
      "require_once __DIR__ . \"/includes/config.php\";",
      "global \\$conn;",
      "",
      "\\$options = mysqli_query(\\$conn, \"SELECT ${1:fkCol}, ${2:labelCol1}, ${3:labelCol2} FROM `${4:ParentTable}` ORDER BY ${2:labelCol1}\");",
      "",
      "\\$message = \"\";",
      "if (isset(\\$_POST[\"submit\"])) {",
      "    \\$field1 = \\$_POST[\"${5:field1}\"];",
      "    \\$field2 = \\$_POST[\"${6:field2}\"];",
      "    \\$fkID   = \\$_POST[\"${1:fkCol}\"];",
      "",
      "    \\$sql = \"INSERT INTO `${7:Table}` (${5:field1}, ${6:field2}, ${1:fkCol})",
      "            VALUES ('\\$field1', '\\$field2', '\\$fkID')\";",
      "    if (mysqli_query(\\$conn, \\$sql)) {",
      "        header(\"location: ${8:list.php}\");",
      "        exit;",
      "    }",
      "    \\$message = mysqli_error(\\$conn);",
      "}",
      "?>",
      "<!DOCTYPE html>",
      "<html lang=\"en\" data-bs-theme=\"dark\">",
      "<head>",
      "    <meta charset=\"UTF-8\">",
      "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "    <title>Add ${9:Record}</title>",
      "    <link rel=\"stylesheet\" href=\"assets/bootstrap.css\">",
      "</head>",
      "<body>",
      "<div class=\"container mt-4\">",
      "    <h1>Add ${9:Record}</h1>",
      "    <?php if (\\$message !== \"\") { ?>",
      "        <div class=\"alert alert-danger\"><?= \\$message ?></div>",
      "    <?php } ?>",
      "    <form method=\"POST\" class=\"rounded\">",
      "        <label for=\"${5:field1}\" class=\"form-label\">${10:Field 1}</label>",
      "        <input id=\"${5:field1}\" name=\"${5:field1}\" class=\"form-control\" required>",
      "",
      "        <label for=\"${6:field2}\" class=\"form-label\">${11:Field 2}</label>",
      "        <input id=\"${6:field2}\" name=\"${6:field2}\" class=\"form-control\" required>",
      "",
      "        <label for=\"${1:fkCol}\" class=\"form-label\">${12:Label}</label>",
      "        <select id=\"${1:fkCol}\" name=\"${1:fkCol}\" class=\"form-select\" required>",
      "            <option value=\"\">- choose one -</option>",
      "            <?php while (\\$opt = mysqli_fetch_assoc(\\$options)) { ?>",
      "                <option value=\"<?= \\$opt[\"${1:fkCol}\"] ?>\"><?= \\$opt[\"${2:labelCol1}\"] ?> <?= \\$opt[\"${3:labelCol2}\"] ?></option>",
      "            <?php } ?>",
      "        </select>",
      "",
      "        <button type=\"submit\" name=\"submit\" class=\"btn btn-primary mt-2\">Save</button>",
      "        <a href=\"${8:list.php}\" class=\"btn btn-secondary mt-2\">Cancel</a>",
      "    </form>",
      "</div>",
      "</body>",
      "</html>"
    ]
  },
